# Public port and bind address. Keep 127.0.0.1 unless you intentionally expose it on a LAN.
HOST=127.0.0.1
PORT=30100

# Optional Basic Auth. Strongly recommended when HOST is 0.0.0.0.
AGENT_HISTORY_USERNAME=
AGENT_HISTORY_PASSWORD=

# Optional data path overrides. Leave commented to use the current user's home directory
# (~/.codex/sessions and ~/.claude/projects). Only set these when your history lives elsewhere.
# CODEX_HISTORY_ROOT=~/.codex/sessions
# CLAUDE_HISTORY_ROOT=~/.claude/projects
AGENT_HISTORY_STATE=./state

# Optional portable archive upload limit in bytes (default: 512 MiB).
AGENT_HISTORY_IMPORT_MAX_BYTES=536870912
